[core]
    editor = hx
    autocrlf = input
    whitespace = trailing-space,space-before-tab

[init]
    defaultBranch = main

[pull]
    rebase = false

[push]
    autoSetupRemote = true

[color]
    ui = auto

[alias]
    st = status
    co = checkout
    br = branch
    lg = log --oneline --graph --decorate --all
    undo = reset --soft HEAD~1
    amend = commit --amend --no-edit

[diff]
    tool = vimdiff

[user]
    name = Flaouve
    email = flaouve@gmail.com
    signingkey = 02FC8EA3CD0EA7AB

[commit]
    gpgsign = true